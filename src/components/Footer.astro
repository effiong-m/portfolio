---
import { getEntry } from 'astro:content';

const config = await getEntry('config', 'site');
const { website } = config!.data;
---

<footer class="portfolio-footer print:hidden">
  <div class="footer-inner">

    <p class="footer-contact">
      Get in touch:{' '}
      <a href={`mailto:${ website.email}`}>
        { website.email }
      </a>
    </p>

    {
      website.socials.length > 0 && (
        <div class="footer-links">
          {website.socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {social.name}
            </a>
          ))}
        </div>
      )
    }

    <p class="footer-copyright">
      © {new Date().getFullYear()} {website.name}
    </p>

  </div>
</footer>

<style>
  .portfolio-footer {
    margin-top: 6rem;
    padding: 2rem 1.5rem;

    border-top: 1px solid var(--color-border-soft);

    color: var(--color-text-muted);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;

    max-width: 72rem;
    margin-inline: auto;

    font-size: 0.85rem;
  }

  .footer-contact {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .portfolio-footer a {
    color: var(--color-text);
    text-decoration: none;
  }

  .portfolio-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer-copyright {
    margin: 0 0 0 auto;
  }

  @media (max-width: 640px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-copyright {
      margin-left: 0;
    }
  }
</style>
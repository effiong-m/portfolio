---
import { SEO } from 'astro-seo';
import '@/styles/global.css';
import { getEntry } from 'astro:content';

import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';

import { ClientRouter } from 'astro:transitions';

const config = await getEntry('config', 'site');
const { website } = config!.data;

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const globalTitle = title
  ? `${title} - ${website.name}`
  : website.name;

const globalDescription =
  description || "${website.name} engineering portfolio";

// Custom View Transition Animation
const anim = {
  old: {
    name: 'change-page',
    duration: '0.3s',
    easing: 'ease-out',
    direction: 'reverse',
  },
  new: {
    name: 'change-page',
    duration: '0.3s',
    easing: 'ease-out',
  },
};

const customTransition = {
  forwards: anim,
  backwards: anim,
};
---

<!DOCTYPE html>
<html
  class="font-sans-serif"
  lang="en"
  translate="no"
>
  <head>
    <SEO
      charset="UTF-8"
      title={globalTitle}
      description={globalDescription}
      extend={{
        meta: [
          {
            name: 'viewport',
            content: 'width=device-width, initial-scale=1',
          },
          {
            name: 'google',
            content: 'notranslate',
          },
        ],
      }}
    />

    <ClientRouter fallback="swap" />
  </head>

  <body class="print:bg-none">
    <Navbar />

    <div
      transition:animate={customTransition}
      style="margin-top: calc(var(--navbar-height) * -1);"
    >
      <slot />
    </div>

    <Footer />
  </body>
</html>

<style is:inline>
  @media print {
    .no-print,
    .no-print * {
      display: none !important;
    }
  }

  @keyframes change-page {
    0% {
      opacity: 0;
      transform: translateY(-5px);
    }

    50% {
      opacity: 0.1;
    }

    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>